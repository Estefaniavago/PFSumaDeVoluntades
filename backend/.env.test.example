# Configuración para las pruebas automáticas (npm test).
# Copiar este archivo como .env.test y completar la contraseña de PostgreSQL.
# El archivo .env.test no se sube al repositorio.

# Base SEPARADA para las pruebas: se borra y se vuelve a crear con "npm run db:test".
# El nombre tiene que terminar en _test; si no, las pruebas de integración no se ejecutan.
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/suma_voluntades_test

# Clave solo para las pruebas (no es la de producción).
JWT_SECRET=clave_solo_para_pruebas_automaticas

PORT=3001
