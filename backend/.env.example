# Copiar este archivo como .env y completar con los datos de tu instalación.
# El archivo .env no se sube al repositorio.

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/suma_voluntades

# Clave para firmar los tokens de sesión. Usar una cadena larga y aleatoria.
JWT_SECRET=cambiar_por_una_clave_larga

PORT=3000
